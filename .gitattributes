# 统一换行符与二进制文件标记
# https://git-scm.com/docs/gitattributes

* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary

*.ts linguist-language=TypeScript
*.js linguist-language=JavaScript
*.yml linguist-language=YAML
