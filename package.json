{
  "name": "dsh-safe-delete",
  "version": "0.2.0",
  "description": "Safe delete plugin for DeepSeek Harness (DSH): move files to trash / staging area instead of permanent removal, with restore and purge support.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "safe-delete",
    "trash",
    "file-management"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Qintsg/dsh-safe-delete.git"
  },
  "bugs": {
    "url": "https://github.com/Qintsg/dsh-safe-delete/issues"
  },
  "homepage": "https://github.com/Qintsg/dsh-safe-delete#readme",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "docs",
    "examples",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && node scripts/build-client.mjs",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src tests scripts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-home-paths": ">=0.1.0-rc.3 <0.2.0",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.2 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.2 <0.2.0",
    "@deepseek-ai/dsh-user-approval": ">=0.1.0-rc.2 <0.2.0",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-home-paths": ">=0.1.0-rc.3 <0.2.0",
    "@deepseek-ai/dsh-sandbox-policy": "^0.1.0-rc.6",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "oxlint": "^1.78.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "license": "Apache-2.0"
}
